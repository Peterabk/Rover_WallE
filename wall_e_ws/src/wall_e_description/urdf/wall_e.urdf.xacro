<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wall_e">

  <xacro:include filename="$(find wall_e_description)/urdf/wall_e.gazebo.xacro"/>
  <xacro:include filename="$(find wall_e_description)/urdf/wall_e_ros2_control.xacro"/>

  <link name="base_footprint">
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.02"/>
  </joint>
  
  <link
    name="base_link">
    <inertial>
      <origin
        xyz="2.12503625807159E-17 0 -0.0212688653283583"
        rpy="0 0 0" />
      <mass
        value="19.7944372375747" />
      <inertia
        ixx="0.236926173828267"
        ixy="2.08285401729832E-18"
        ixz="3.25260651745651E-19"
        iyy="0.335947375820388"
        iyz="7.19978005166155E-21"
        izz="0.566141968007365" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://wall_e_description/meshes/base_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.752941176470588 0.752941176470588 0.752941176470588 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://wall_e_description/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>
  <link
    name="FL_link">
    <inertial>
      <origin
        xyz="-2.7756E-16 -0.049964 -1.9915E-15"
        rpy="0 0 0" />
      <mass
        value="1.7656" />
      <inertia
        ixx="0.0039551"
        ixy="1.3837E-18"
        ixz="-2.0269E-19"
        iyy="0.0049701"
        iyz="1.6232E-18"
        izz="0.0039551" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://wall_e_description/meshes/FL_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.29804 0.29804 0.29804 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://wall_e_description/meshes/FL_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="FL_joint"
    type="continuous">
    <origin
      xyz="0.31152 0.302 -0.099351"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="FL_link" />
    <axis
      xyz="0 1 0" />
  </joint>
  <link
    name="FR_link">
    <inertial>
      <origin
        xyz="0 0.049964 6.9389E-18"
        rpy="0 0 0" />
      <mass
        value="1.7656" />
      <inertia
        ixx="0.0039551"
        ixy="-7.6372E-19"
        ixz="1.5112E-19"
        iyy="0.0049701"
        iyz="-1.9258E-19"
        izz="0.0039551" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://wall_e_description/meshes/FR_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.29804 0.29804 0.29804 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://wall_e_description/meshes/FR_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="FR_joint"
    type="continuous">
    <origin
      xyz="0.31152 -0.302 -0.099351"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="FR_link" />
    <axis
      xyz="0 1 0" />
  </joint>
  <link
    name="BL_link">
    <inertial>
      <origin
        xyz="5.5511E-17 -0.049964 6.9389E-18"
        rpy="0 0 0" />
      <mass
        value="1.7656" />
      <inertia
        ixx="0.0039551"
        ixy="2.3359E-19"
        ixz="-5.627E-20"
        iyy="0.0049701"
        iyz="-5.1707E-20"
        izz="0.0039551" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://wall_e_description/meshes/BL_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.29804 0.29804 0.29804 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://wall_e_description/meshes/BL_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="BL_joint"
    type="continuous">
    <origin
      xyz="-0.31152 0.302 -0.099351"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="BL_link" />
    <axis
      xyz="0 1 0" />
  </joint>
  <link
    name="BR_link">
    <inertial>
      <origin
        xyz="5.5511E-17 0.049964 -6.9389E-18"
        rpy="0 0 0" />
      <mass
        value="1.7656" />
      <inertia
        ixx="0.0039551"
        ixy="6.4164E-19"
        ixz="5.5883E-20"
        iyy="0.0049701"
        iyz="-1.0198E-19"
        izz="0.0039551" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://wall_e_description/meshes/BR_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.29804 0.29804 0.29804 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://wall_e_description/meshes/BR_link.STL" />
      </geometry>
    </collision>
  </link>

    <joint
    name="BR_joint"
    type="continuous">
    <origin
      xyz="-0.31152 -0.302 -0.099351"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="BR_link" />
    <axis
      xyz="0 1 0" />
  </joint>

  <link
    name="IMU_link">
    <inertial>
      <origin
        xyz="-4.3368E-19 -1.7347E-18 -0.005"
        rpy="0 0 0" />
      <mass
        value="0.089" />
      <inertia
        ixx="1.9283E-05"
        ixy="0"
        ixz="0"
        iyy="3.7083E-06"
        iyz="-4.7189E-39"
        izz="2.1508E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://wall_e_description/meshes/IMU_link.STL" />
      </geometry>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://wall_e_description/meshes/IMU_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="IMU_joint"
    type="fixed">
    <origin
      xyz="0 0 0.01"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="IMU_link" />
    <axis
      xyz="0 0 0" />
  </joint>

    <link name="gps_link"/>

    <!-- Add the gps link so we get a static transform for the GPS -->
    <joint name="gps_joint" type="fixed">
      <parent link="base_link"/>
      <child link="gps_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>


    </robot>